class Main {
    public static void main(String[] args) {
        int a[] = {2, 5, 8, 3, 6};
        int e = 0, o = 0;
        for (int i = 0; i < a.length; i++) {
            if (a[i] % 2 == 0)
                e++;
            else
                o++;
        }
        System.out.println(e + " " + o);
    }
}
