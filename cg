public class Main {
    public static void main(String[] args) {

        int[] arr = {17, 18, 5, 4, 6, 1};

        int n = arr.length;

        int max = -1;

        for (int i = n - 1; i >= 0; i--) {

            int current = arr[i];

            arr[i] = max;

            if (current > max) {
                max = current;
            }
        }

        // Print
        for (int i = 0; i < n; i++) {
            System.out.print(arr[i] + " ");
        }
    }
}
